{
    "name": "Open local Link",
    "version": "1.1.0",
    "manifest_version": 3,
    "description": "Open local link by clicking",
    "icons": {
        "128": "icon-128.png"
    },
    "permissions": [
        "nativeMessaging"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content_script.js"],
            "run_at": "document_idle",
            "all_frames": true
        }
    ],
    "options_page": "./install.html" 
}
